# Image derived from OpenCode with git and init script
# Usage: podman build -t arche-workspace .

ARG OPENCODE_VERSION

FROM docker.io/golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS workspace-agent
WORKDIR /src
COPY workspace-agent/go.mod ./
COPY workspace-agent/main.go workspace-agent/connector-proxy.go ./
COPY workspace-agent/cmd/ ./cmd/
RUN CGO_ENABLED=0 go build -o /workspace-agent
RUN CGO_ENABLED=0 go build -o /prepare-workspace-volumes ./cmd/prepare-workspace-volumes

FROM docker.io/node:24.14.0-alpine AS arche-tools
WORKDIR /opt/arche/arche-tools
RUN corepack enable
COPY arche-tools/package.json ./package.json
COPY arche-tools/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile --prod --ignore-scripts
COPY arche-tools/server.js ./server.js
COPY arche-tools/shared/*.js ./shared/
COPY arche-tools/shared/scratch-isolation/*.js ./shared/scratch-isolation/
COPY arche-tools/tools/*.js ./tools/

FROM ghcr.io/anomalyco/opencode:${OPENCODE_VERSION}

# Install git (required for KB sync)
USER root
RUN apk add --no-cache ca-certificates git nodejs

# Install the harness-independent stdio MCP tools.
WORKDIR /opt/arche/arche-tools
COPY --from=arche-tools /opt/arche/arche-tools /opt/arche/arche-tools

# Create non-root user for running the workspace
RUN addgroup -g 1000 workspace && \
    adduser -u 1000 -G workspace -h /home/workspace -s /bin/sh -D workspace && \
    mkdir -p /workspace /kb /kb-content /user-data /tmp/arche-user-data /volumes/0 /volumes/1 /volumes/2 && \
    chown -R workspace:workspace /workspace /kb /user-data

# Workspace agent (HTTP API for git/file ops)
COPY --from=workspace-agent /workspace-agent /usr/local/bin/workspace-agent
COPY --from=workspace-agent /prepare-workspace-volumes /usr/local/bin/prepare-workspace-volumes

# Workspace initialization script
COPY init-workspace.sh /usr/local/bin/init-workspace.sh
RUN chmod +x /usr/local/bin/init-workspace.sh

# Entrypoint wrapper that initializes workspace before starting OpenCode
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER 1000:1000
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
