generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserKind {
  HUMAN
  SERVICE
}

enum ProviderCredentialStatus {
  enabled
  disabled
}

enum FlowRunStatus {
  running
  waiting_for_human
  succeeded
  failed
  cancelled
}

enum FlowRunTrigger {
  on_create
  schedule
  manual
  resume
}

enum FlowRunStepStatus {
  pending
  running
  waiting_for_human
  succeeded
  skipped
  failed
}

enum FlowNodeType {
  agent
  human
  condition
  slack
  merge
  compaction
}

enum SlackPendingDecisionStatus {
  pending
  continued
  started_new
  expired
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  slug         String      @unique
  role         UserRole    @default(USER)
  kind         UserKind    @default(HUMAN)
  passwordHash String      @map("password_hash")
  totpEnabled    Boolean     @default(false) @map("totp_enabled")
  totpSecret     String?     @map("totp_secret")
  totpVerifiedAt DateTime?   @map("totp_verified_at")
  totpLastUsedAt DateTime?   @map("totp_last_used_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  sessions           Session[]
  personalAccessTokens PersonalAccessToken[]
  auditEvents        AuditEvent[] @relation("AuditActor")
  instance           Instance?
  twoFactorRecovery  TwoFactorRecovery[]
  connectors         Connector[]
  providerCredentials ProviderCredential[]
  providerUsageDaily  ProviderUsageDaily[]
  providerUsageRuns   ProviderUsageRun[]
  flows               Flow[]
  slackThreadBindings SlackThreadBinding[]
  slackUserLinks      SlackUserLink[]
  slackDmSessionBindings SlackDmSessionBinding[]

  @@map("users")
}

model ExternalIntegration {
  key       String   @id @map("key")
  config    String   // AES-256-GCM encrypted JSON
  state     Json?    @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("external_integrations")
}

model SlackThreadBinding {
  id               String   @id @default(cuid())
  channelId        String   @map("channel_id")
  threadTs         String   @map("thread_ts")
  openCodeSessionId String  @map("opencode_session_id")
  executionUserId  String   @map("execution_user_id")
  executionUser    User     @relation(fields: [executionUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([channelId, threadTs])
  @@index([executionUserId])
  @@map("slack_thread_bindings")
}

model SlackEventReceipt {
  id         String   @id @default(cuid())
  eventId    String   @unique @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("slack_event_receipts")
}

model SlackUserLink {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  slackTeamId String   @map("slack_team_id")
  slackUserId String   @map("slack_user_id")
  slackEmail  String?  @map("slack_email")
  displayName String?  @map("display_name")
  lastSeenAt  DateTime @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slackTeamId, slackUserId])
  @@index([userId])
  @@map("slack_user_links")
}

model SlackDmSessionBinding {
  id                String   @id @default(cuid())
  slackTeamId       String   @map("slack_team_id")
  slackUserId       String   @map("slack_user_id")
  channelId         String   @map("channel_id")
  executionUserId   String   @map("execution_user_id")
  openCodeSessionId String   @unique @map("opencode_session_id")
  startedAt         DateTime @default(now()) @map("started_at")
  lastMessageAt     DateTime @default(now()) @map("last_message_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  executionUser     User     @relation(fields: [executionUserId], references: [id], onDelete: Cascade)

  @@index([slackTeamId, slackUserId, lastMessageAt])
  @@index([executionUserId])
  @@map("slack_dm_session_bindings")
}

model SlackPendingDmDecision {
  id                         String                       @id @default(cuid())
  sourceEventId              String                       @unique @map("source_event_id")
  slackTeamId                String                       @map("slack_team_id")
  slackUserId                String                       @map("slack_user_id")
  channelId                  String                       @map("channel_id")
  sourceTs                   String                       @map("source_ts")
  messageText                String                       @map("message_text")
  previousDmSessionBindingId String?                      @map("previous_dm_session_binding_id")
  expiresAt                  DateTime                     @map("expires_at")
  status                     SlackPendingDecisionStatus   @default(pending)
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("slack_pending_dm_decisions")
}

model SlackNotificationChannel {
  id          String   @id @default(cuid())
  slackTeamId String   @map("slack_team_id")
  channelId   String   @map("channel_id")
  name        String
  isPrivate   Boolean  @default(false) @map("is_private")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([slackTeamId, channelId])
  @@map("slack_notification_channels")
}

enum InstanceStatus {
  starting
  running
  stopped
  error
}

model Instance {
  id              String         @id @default(cuid())
  slug            String         @unique

  status          InstanceStatus @default(stopped)

  createdAt       DateTime       @default(now()) @map("created_at")
  startedAt       DateTime?      @map("started_at")
  stoppedAt       DateTime?      @map("stopped_at")
  lastActivityAt  DateTime?      @map("last_activity_at")

  containerId     String?        @map("container_id")
  serverPassword  String         @map("server_password")
  appliedConfigSha String?       @map("applied_config_sha")
  providerSyncHash String?       @map("provider_sync_hash")
  providerSyncedAt DateTime?     @map("provider_synced_at")

  user            User           @relation(fields: [slug], references: [slug])

  @@index([status])
  @@map("instances")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @map("token_hash")

  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime? @map("last_seen_at")

  ip        String? @map("ip")
  userAgent String? @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PersonalAccessToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  lookupHash String    @unique @map("lookup_hash")
  tokenHash  String    @unique @map("token_hash")
  salt       String
  scopes     String[]  @default(["kb:read"])
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_events")
}

model MessageRun {
  id         String   @id
  slug       String
  sessionId  String   @map("opencode_session_id")
  source     String
  status     String   @default("running")
  error      String?
  startedAt  DateTime @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  lock       MessageRunLock?
  providerUsageRun ProviderUsageRun?

  @@index([slug, sessionId, status])
  @@index([startedAt])
  @@map("message_runs")
}

model MessageRunLock {
  slug      String
  sessionId String   @map("opencode_session_id")
  runId     String   @unique @map("run_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  run       MessageRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([slug, sessionId])
  @@index([runId])
  @@map("message_run_locks")
}

model Flow {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  definition     Json
  cronExpression String?        @map("cron_expression")
  timezone       String         @default("UTC")
  enabled        Boolean        @default(false)

  nextRunAt      DateTime?      @map("next_run_at")
  lastRunAt      DateTime?      @map("last_run_at")
  leaseOwner     String?        @map("lease_owner")
  leaseExpiresAt DateTime?      @map("lease_expires_at")

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  runs           FlowRun[]

  @@index([userId])
  @@index([userId, name])
  @@index([enabled, nextRunAt])
  @@index([leaseExpiresAt])
  @@index([userId, leaseExpiresAt])
  @@map("flows")
}

model FlowRun {
  id                String        @id @default(cuid())
  flowId            String        @map("flow_id")
  flow              Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)

  status            FlowRunStatus
  trigger           FlowRunTrigger
  scheduledFor      DateTime      @map("scheduled_for")
  startedAt         DateTime      @default(now()) @map("started_at")
  finishedAt        DateTime?     @map("finished_at")
  error             String?
  openCodeSessionId String?       @unique @map("opencode_session_id")
  sessionTitle      String?       @map("session_title")
  currentNodeId     String?       @map("current_node_id")
  resultSeenAt      DateTime?     @map("result_seen_at")
  attempt           Int           @default(1)
  retryScheduledFor DateTime?     @map("retry_scheduled_for")
  lastRetryError    String?       @map("last_retry_error")

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  steps             FlowRunStep[]

  @@index([flowId, startedAt])
  @@index([status])
  @@index([scheduledFor])
  @@index([retryScheduledFor])
  @@map("flow_runs")
}

model FlowRunStep {
  id              String            @id @default(cuid())
  runId           String            @map("run_id")
  run             FlowRun           @relation(fields: [runId], references: [id], onDelete: Cascade)

  nodeId          String            @map("node_id")
  nodeName        String?           @map("node_name")
  nodeType        FlowNodeType      @map("node_type")
  status          FlowRunStepStatus
  input           Json?
  rawOutput       String?           @map("raw_output")
  compactedOutput String?           @map("compacted_output")
  humanResponse   String?           @map("human_response")
  error           String?
  startedAt       DateTime?         @map("started_at")
  finishedAt      DateTime?         @map("finished_at")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([runId, nodeId])
  @@index([runId])
  @@index([status])
  @@map("flow_run_steps")
}

model Connector {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // ConnectorType from src/lib/connectors/types.ts
  name      String
  config    String   // AES-256-GCM encrypted JSON
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("connectors")
}

model ProviderCredential {
  id         String                   @id @default(cuid())
  userId     String                   @map("user_id")
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String                   @map("provider_id")
  type       String
  status     ProviderCredentialStatus @default(enabled)
  version    Int
  secret     String
  lastError  String?                  @map("last_error")
  lastUsedAt DateTime?                @map("last_used_at")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  @@index([userId])
  @@index([providerId])
  @@map("provider_credentials")
}

model OrganizationProviderCredential {
  id         String                   @id @default(cuid())
  providerId String                   @map("provider_id")
  type       String
  status     ProviderCredentialStatus @default(enabled)
  version    Int
  secret     String
  lastError  String?                  @map("last_error")
  lastUsedAt DateTime?                @map("last_used_at")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  @@index([providerId])
  @@map("organization_provider_credentials")
}

model ProviderUsageDaily {
  id               String   @id @default(cuid())
  bucketDate       DateTime @map("bucket_date") @db.Date
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId       String   @map("provider_id")
  modelId          String   @default("") @map("model_id")
  source           String
  credentialSource String   @map("credential_source")
  requestCount     Int      @default(0) @map("request_count")
  errorCount       Int      @default(0) @map("error_count")
  runCount         Int      @default(0) @map("run_count")
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  costUsd          Decimal  @default(0) @map("cost_usd") @db.Decimal(18, 8)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([bucketDate, userId, providerId, modelId, source, credentialSource], map: "provider_usage_daily_bucket_user_provider_model_source_key")
  @@index([bucketDate])
  @@index([userId])
  @@index([providerId, modelId])
  @@map("provider_usage_daily")
}

model ProviderUsageRun {
  id               String     @id @default(cuid())
  messageRunId     String     @unique @map("message_run_id")
  messageRun       MessageRun @relation(fields: [messageRunId], references: [id], onDelete: Cascade)
  userId           String     @map("user_id")
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId       String     @map("provider_id")
  modelId          String     @default("") @map("model_id")
  source           String
  credentialSource String     @map("credential_source")
  inputTokens      Int        @default(0) @map("input_tokens")
  outputTokens     Int        @default(0) @map("output_tokens")
  costUsd          Decimal    @default(0) @map("cost_usd") @db.Decimal(18, 8)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@index([providerId, modelId])
  @@index([createdAt])
  @@map("provider_usage_runs")
}

model TwoFactorRecovery {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("two_factor_recovery")
}
